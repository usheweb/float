{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "唐三浪悬浮窗",
  "mainBinaryName": "tangsanlang-float",
  "version": "0.3.17",
  "identifier": "com.tangsanlang.floating",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "唐三浪悬浮窗",
        "width": 420,
        "height": 500,
        "minWidth": 380,
        "minHeight": 240,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      },
      {
        "label": "tip",
        "url": "tooltip.html",
        "title": "提示",
        "width": 240,
        "height": 186,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}

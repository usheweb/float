{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "唐三浪悬浮窗",
        "width": 420,
        "height": 500,
        "minWidth": 380,
        "minHeight": 240,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "noRedirectionBitmap": true
      },
      {
        "label": "tip",
        "url": "tooltip.html",
        "title": "提示",
        "width": 240,
        "height": 186,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "noRedirectionBitmap": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"]
  }
}
